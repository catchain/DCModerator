# --- Telegram ---
BOT_TOKEN=

# ID чатов уже с префиксом -100 (супергруппы/каналы).
# Если вставить "голый" id, бот сам добавит -100 при старте.
MODERATED_CHAT_ID=-1001096132026

# ID привязанного канала (не группы обсуждений!). Несколько id через запятую:
#   -1001012435573,1012435573  — оба формата одного канала
PROTECTED_CHANNEL_ID=-1001012435573,1012435573

# Канал/чат для логов действий модерации (бот должен быть там админом).
# Оставь пустым, чтобы отключить логирование в Telegram.
LOG_CHAT_ID=-1005191700657

# --- Модерация ---
# "Новичок" = пользователь, у которого меньше N засчитанных сообщений.
# У новичков удаляются ЛЮБЫЕ ссылки; у остальных — только из чёрного списка.
NEWBIE_MESSAGE_THRESHOLD=5

# Система варнов: лимит и длительность мута (в часах) при его достижении.
WARN_LIMIT=3
WARN_MUTE_HOURS=48

# Антифлуд: больше FLOOD_MAX_MESSAGES за FLOOD_WINDOW_SEC секунд -> мут на FLOOD_MUTE_MIN минут.
FLOOD_MAX_MESSAGES=5
FLOOD_WINDOW_SEC=5
FLOOD_MUTE_MIN=5

# --- AI-модерация (опционально, OpenAI omni-moderation — бесплатна) ---
AI_MODERATION=false
OPENAI_API_KEY=

# --- Прочее ---
# Путь к файлу БД (SQLite).
DB_PATH=./data/moderator.db
# Период /top по умолчанию: 1d | 7d | 30d
DEFAULT_TOP_PERIOD=7d
# Интервал обновления кэша админов, минут.
ADMIN_REFRESH_MIN=10
# Постоянные админы (Telegram user id через запятую). По умолчанию: 336163.
STATIC_ADMIN_IDS=336163
